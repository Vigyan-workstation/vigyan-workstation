#!/usr/bin/env bash
# ==============================================================================
# Vigyan Pro Sovereign Studio - Native Desktop Launcher
# Pitch-Black Obsidian STEM Studio with LaTeX, Native Plots, and Local Inference
# ==============================================================================

set -e

# 1. Auto-start Ollama if offline
if ! curl -s http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    systemctl --user start ollama.service 2>/dev/null || \
    (OLLAMA_ORIGINS="*" OLLAMA_HOST="127.0.0.1:11434" nohup ollama serve >/dev/null 2>&1 &) || true
    sleep 1
fi

# 2. Dynamic discovery of desktop runtime
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/../src/launch_desktop.py" ]; then
    exec /usr/bin/python3 "$SCRIPT_DIR/../src/launch_desktop.py" "$@"
elif [ -f "/opt/vigyan-pro/src/launch_desktop.py" ]; then
    exec /usr/bin/python3 "/opt/vigyan-pro/src/launch_desktop.py" "$@"
else
    exec /usr/bin/python3 "$HOME/.vigyan/desktop/launch_desktop.py" "$@"
fi
